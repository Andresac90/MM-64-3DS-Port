; Uniforms
; PORT (2026-09-30): stereoscopic 3D. Positions arrive in clip space (transformed on the CPU); the
; screen's horizontal axis is clip y here (the top-screen target is portrait). Per eye:
;   out.y += eye.x * stereo + eye.w * w
; stereo (v4) = the vertex's clip-space depth offset for a shift of 1, computed on the CPU from the
; comfort curve (gfx_pc.c stereo_offset: convergence on Link, soft pop-out limit, 0 for the 2D HUD) and
; interpolated like the position when triangles are clipped/split, so there are no cracks.
; eye.x = this eye's shift (NDC, signed), eye.w = a constant NDC shift for flat layers (sky, pre-rendered
; room pictures), eye.z = a matching zoom for those pictures (a shifted picture uncovered its edge: the
; "void" beside shop rooms in 3D). eye = 0 (mono, off-screen targets, the HUD layer) leaves positions untouched.
.fvec eye
; remap: out.y = out.y * remap.x + w * remap.y (right-eye viewports whose origin would be >= 512 on the
; long axis are moved down to 400 and made taller; this puts the geometry back on the same pixels)
.fvec remap

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

; Inputs (defined as aliases for convenience)
.alias inpos v0
.alias intex v1
.alias inclr v2
.alias intex1 v3
.alias instereo v4

.proc main
	mov r0, inpos
	mov r1, eye
	; eye.z: horizontal zoom for shifted flat pictures (pre-rendered rooms), so their edges stay covered
	mul r8.x, r1.z, r0.y
	add r0.y, r0.y, r8.x
	; eye.x * stereo + eye.w * w
	mul r2.x, r1.x, instereo.x
	mul r3.x, r1.w, inpos.w
	add r2.x, r2.x, r3.x
	add r0.y, r0.y, r2.x
	; viewport remap (identity (1, 0) except for the right eye's far viewports)
	mov r5, remap
	mul r6.x, r5.x, r0.y
	mul r7.x, r5.y, r0.w
	add r0.y, r6.x, r7.x
	mov outpos, r0

    mov outtc0, intex
    mov outtc1, intex1

	mov outclr, inclr

	end
.end
